<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="DefaultControls">
        <uie:PropertyField name="NodeGraph" binding-path="nodeGraph" />
        <uie:PropertyField name="TestPointA" binding-path="testPointA" />
        <uie:PropertyField name="TestPointB" binding-path="testPointB" />
        <uie:PropertyField name="DebugHullDef" binding-path="debugHullDef" />
        <uie:PropertyField name="GraphType" binding-path="graphType" />
    </ui:VisualElement>
    <ui:VisualElement name="NodePlacerContainer" style="border-top-width: 3px; border-left-color: rgb(47, 47, 47); border-right-color: rgb(47, 47, 47); border-top-color: rgb(47, 47, 47); border-bottom-color: rgb(47, 47, 47);">
        <uie:ObjectField label="Parent Game Object" name="ParentGameObject" type="UnityEngine.GameObject, UnityEngine.CoreModule" />
        <ui:Toggle label="Round to Nearest Grid" name="RoundPointToGrid" />
        <ui:Toggle label="Draw All Nodes" name="DrawAllNodes" />
        <uie:FloatField label="Draw Node Distance" value="22500" name="DrawNodeDistance" tooltip="Sqrt magnitude between current camera position and node at which node cylinder will stop rendering." />
        <ui:TextField picking-mode="Ignore" label="Gate Name" name="GateName" />
        <ui:VisualElement name="FlagContainer" />
        <ui:Toggle label="Use Painter" name="UsePainter" />
        <ui:VisualElement name="PainterContainer" style="display: none;">
            <RoR2.Editor.ExtendedHelpBox message="The Painter for Map Nodes is a legacy feature and is not supported directly by Nebby. Bugs related to it will be fixed by the community" message-type="Info" />
            <uie:FloatField label="Painter Size" value="42,2" name="BrushSize" />
            <uie:FloatField label="Distance Between Nodes" value="15" name="NodeDistance" />
        </ui:VisualElement>
        <ui:VisualElement name="ButtonContainer">
            <ui:VisualElement style="flex-direction: row; flex-grow: 0; flex-shrink: 0; align-items: center; justify-content: center;">
                <ui:Button text="Update no Ceiling Masks" display-tooltip-when-elided="true" name="UpdateNoCeilingMasks" style="flex-grow: 1; width: 50%;" />
                <ui:Button text="Update Teleporter Masks" display-tooltip-when-elided="true" name="UpdateTeleporterMasks" style="flex-grow: 1; width: 50%;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0;">
                <ui:Button text="Update Hull Masks" display-tooltip-when-elided="true" name="UpdateHullMasks" style="flex-grow: 1; width: 50%;" />
                <ui:Button text="Remove Unconnected Nodes" display-tooltip-when-elided="true" name="RemoveNodeExcess" style="flex-grow: 1; width: 50%;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0;">
                <ui:Button text="Make Air Nodes" display-tooltip-when-elided="true" name="MakeAirNodes" style="width: 50%;" />
                <ui:Button text="Make Ground Nodes" display-tooltip-when-elided="true" name="MakeGroundNodes" style="width: 50%;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0;">
                <ui:Button text="Disable Node Icons" display-tooltip-when-elided="true" name="DisableNodeIcons" style="width: 50%;" />
                <ui:Button text="Enable Node Icons" display-tooltip-when-elided="true" name="EnableNodeIcons" style="width: 50%;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; flex-grow: 0; flex-shrink: 0;">
                <ui:Button text="Bake Graph Optimized" display-tooltip-when-elided="true" name="BakeNodeGraph" style="width: 50%;" />
                <ui:Button text="Bake Vanilla" display-tooltip-when-elided="true" name="BakeVanilla" style="width: 50%;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; flex-grow: 0; align-items: center; justify-content: center; flex-shrink: 0;">
                <ui:Button text="Clear Nodes" display-tooltip-when-elided="true" name="ClearNodes" style="color: rgb(255, 0, 0); width: 100%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ProgressBar value="0.5" title="Baking..." name="BakingProgressBar" high-value="1" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
