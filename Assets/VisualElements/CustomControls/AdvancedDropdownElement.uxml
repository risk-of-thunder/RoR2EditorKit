<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Button" class="unity-base-field__input unity-base-popup-field__input unity-popup_field__input">
        <ui:VisualElement name="DropdownIcon" picking-mode="Ignore" style="width: 16px; height: 16px; flex-shrink: 0; margin-right: 4px; display: none; -unity-background-scale-mode: scale-to-fit;" />
        <ui:Label text="Label" display-tooltip-when-elided="true" name="DropdownLabel" class="unity-base-popup-field__text" />
        <ui:VisualElement name="Arrow" class="unity-base-popup-field__arrow" />
    </ui:VisualElement>
</ui:UXML>